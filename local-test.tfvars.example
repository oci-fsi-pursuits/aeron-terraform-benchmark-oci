# -----------------------------------------------------------------------------
# Example Terraform variable file — copy to local-test.tfvars (gitignored).
#   cp local-test.tfvars.example local-test.tfvars
# Never commit local-test.tfvars: it holds tenancy, compartment, network OCIDs,
# and your SSH public key.
#
# Defaults (see README.md → Configuration Options): benchmark/failover E6.Flex
# 16 OCPU / 124 GB; controller E6.Flex 2 OCPU / 16 GB. Uncomment blocks below
# to override git, echo tuning, UDP interface, CPU affinity, placement group, etc.
# -----------------------------------------------------------------------------
# Usage:
#   terraform plan  -var-file="local-test.tfvars"
#   terraform apply -var-file="local-test.tfvars"
# -----------------------------------------------------------------------------

# Required OCI identity inputs
tenancy_ocid     = "ocid1.tenancy.oc1..REPLACE_WITH_YOUR_TENANCY_OCID"
region           = "us-phoenix-1"
compartment_ocid = "ocid1.compartment.oc1..REPLACE_WITH_YOUR_COMPARTMENT_OCID"

# Public key content (not file path)
ssh_public_key = "ssh-rsa AAAAB3...REPLACE_WITH_YOUR_PUBLIC_KEY comment@host"
ssh_username   = "ubuntu"

# -----------------------------------------------------------------------------
# Cluster naming
# -----------------------------------------------------------------------------
use_custom_name = true
cluster_name    = "aeron-local-test"
# Optional: unique VNIC hostnames when several stacks share the same subnets (empty = cluster_name + random_pet when use_custom_name).
# instance_hostname_prefix = "myproj-phx-a"

# -----------------------------------------------------------------------------
# Availability domains (examples for PHX — use your region’s AD names)
# -----------------------------------------------------------------------------
controller_ad = "pILZ:PHX-AD-2"
benchmark_ad  = "pILZ:PHX-AD-2"

enable_failover_node = true
failover_ad          = "pILZ:PHX-AD-1"

# -----------------------------------------------------------------------------
# Node sizing
# -----------------------------------------------------------------------------
controller_shape     = "VM.Standard.E6.Flex"
controller_ocpus     = 2
controller_memory_gb = 16

benchmark_shape        = "VM.Standard.E6.Flex"
benchmark_node_count   = 2
benchmark_ocpus        = 16
benchmark_memory_gb    = 124

failover_shape     = "VM.Standard.E6.Flex"
failover_ocpus     = 16
failover_memory_gb = 124

# create_benchmark_cluster_placement_group = true  # ignored when use_existing_vcn = true

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
hyperthreading                 = false
benchmark_cluster_cpu_affinity = "auto" # or "static" (OCPU×threads only, no SSH probe)
private_deployment             = false

# Option A: existing VCN/subnets
use_existing_vcn           = true
existing_vcn_id            = "ocid1.vcn.oc1..REPLACE"
existing_public_subnet_id  = "ocid1.subnet.oc1..REPLACE"
existing_private_subnet_id = "ocid1.subnet.oc1..REPLACE"

# Option B: new VCN (set use_existing_vcn = false)
# vcn_cidr_block      = "10.0.0.0/16"
# public_subnet_cidr  = "10.0.0.0/24"
# private_subnet_cidr = "10.0.1.0/24"

# -----------------------------------------------------------------------------
# Image / software behavior
# -----------------------------------------------------------------------------
use_default_image = true
install_aeron     = true

run_benchmarks                = false
run_benchmarks_matrix_modes   = "java"

# Default echo tuning (1/1/1) is a smoke-style matrix — fast gate, not CHECKLIST.md baselines. See `terraform output benchmark_driver_matrix`.
# After apply, median latencies appear in `terraform output benchmark_driver_matrix_summary` if OpenSSH + python can reach the controller (toggle off in CI):
# pull_matrix_summary_for_terraform_output = false

# Defaults are already minimal: RUNS=1, ITERATIONS=1, warmup=1, rate=100001. For more stable HDR stats, raise e.g.:
# benchmark_echo_iterations        = 30
# benchmark_echo_warmup_iterations = 10
# benchmark_message_rate           = "101K"

# Echo LoadTestRig: |interface=IP/prefix — use "16" if benchmark nodes are on a /16 subnet (common on OCI).
# aeron_echo_udp_interface_prefix_length = "16"
# Or Aeron 1.50+ named NIC (overrides prefix): use `ip -br a` on a benchmark node, e.g. enp0s9
# aeron_echo_udp_named_interface = "enp0s9"

# Host iptables ACCEPT for benchmark UDP (default true); persist across reboot:
# aeron_benchmark_host_firewall_persistent = true
