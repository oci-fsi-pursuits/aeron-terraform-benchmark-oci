*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Keys and local secrets
*.pem
*.key
id_rsa*
*.p12
*.pfx

# Archives (never commit ad-hoc zips/tarballs that might hold credentials or state)
