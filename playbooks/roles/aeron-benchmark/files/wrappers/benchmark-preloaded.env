#!/usr/bin/env bash
# Source or edit this file before running one of:
#   ./run-benchmark-non-vma.sh [echo|cluster|both]
#   ./run-benchmark-vma.sh [echo|cluster|both]
#
# The wrapper scripts source this file automatically when it is next to them.
# To override for one shell only:
#   source ./benchmark-preloaded.env
#   export AERON_BENCHMARK_RATE=1001000
#   ./run-benchmark-vma.sh echo

# -----------------------------
# Test shape and benchmark size
# -----------------------------
export AERON_BENCHMARK_TARGET="${AERON_BENCHMARK_TARGET:-echo}"
export AERON_BENCHMARK_RATE="${AERON_BENCHMARK_RATE:-101K}"
# export AERON_BENCHMARK_RATE=1001000
export AERON_BENCHMARK_LENGTH="${AERON_BENCHMARK_LENGTH:-288}"
export AERON_BENCHMARK_RUNS="${AERON_BENCHMARK_RUNS:-1}"
export AERON_BENCHMARK_ITERATIONS="${AERON_BENCHMARK_ITERATIONS:-3}"
export AERON_BENCHMARK_WARMUP="${AERON_BENCHMARK_WARMUP:-3}"
export AERON_BENCHMARK_TIMEOUT_SEC="${AERON_BENCHMARK_TIMEOUT_SEC:-1800}"
export AERON_BENCHMARK_STRICT="${AERON_BENCHMARK_STRICT:-0}"

# -----------------------------
# Driver mode selection
# -----------------------------
# Used only by run-benchmark-non-vma.sh.
export AERON_NONVMA_MODES="${AERON_NONVMA_MODES:-java,c}"
# export AERON_NONVMA_MODES=java
# export AERON_NONVMA_MODES=c

# Used only by run-benchmark-vma.sh.
export AERON_VMA_MODES="${AERON_VMA_MODES:-java_vma,c_vma}"
# export AERON_VMA_MODES=java_vma
# export AERON_VMA_MODES=c_vma

# VMA must run with CAP_NET_RAW/root or VMA logs "Interface ens3 will not be offloaded."
# Keep this enabled for meaningful VMA testing on these OCI VMs.
export AERON_VMA_ONLOAD_COMMAND="${AERON_VMA_ONLOAD_COMMAND:-sudo -E env LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libvma.so.9}"
# Non-root fallback for diagnostics only:
# export AERON_VMA_ONLOAD_COMMAND="env LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libvma.so.9"

# -----------------------------
# Expected CPU topology
# -----------------------------
export AERON_EXPECTED_VCPUS="${AERON_EXPECTED_VCPUS:-32}"
export AERON_EXPECTED_ISOLATED_CPUS="${AERON_EXPECTED_ISOLATED_CPUS:-6-31}"
export AERON_AFFINITY_RANGE="${AERON_AFFINITY_RANGE:-6-31}"

# -----------------------------
# Cleanup and host quieting
# -----------------------------
export BENCHMARK_QUIET_MODE="${BENCHMARK_QUIET_MODE:-1}"
export BENCHMARK_QUIET_RESTORE="${BENCHMARK_QUIET_RESTORE:-0}"
export BENCHMARK_DEEP_QUIET="${BENCHMARK_DEEP_QUIET:-1}"
export MATRIX_CLEANUP_AGGRESSIVE="${MATRIX_CLEANUP_AGGRESSIVE:-1}"
export MATRIX_CLEANUP_COOLDOWN_SEC="${MATRIX_CLEANUP_COOLDOWN_SEC:-30}"
export MATRIX_CLEANUP_VERIFY_SEC="${MATRIX_CLEANUP_VERIFY_SEC:-25}"

# -----------------------------
# Optional topology overrides
# -----------------------------
# Leave these commented when ./config/benchmark-config.env is correct.
# export AERON_SSH_KEY_FILE=/opt/aeron/.ssh/deploy_key
# export AERON_SSH_USER=ubuntu
# export AERON_CLIENT_NODE=aeron-benchmark-client
# export AERON_RECEIVER_NODE=aeron-benchmark-receiver
# export AERON_CLUSTER_CLIENT_NODE=aeron-benchmark-client
# export AERON_CLUSTER_NODE0=aeron-benchmark-receiver
# export AERON_FAILOVER_NODE=aeron-benchmark-failover

# -----------------------------
# Optional paths
# -----------------------------
# export AERON_PRELOAD_CONFIG_FILE=/opt/aeron/benchmarks-dist/scripts/config/benchmark-config.env
export AERON_RESULTS_ROOT="${AERON_RESULTS_ROOT:-/home/ubuntu/benchmark-results/runs}"
