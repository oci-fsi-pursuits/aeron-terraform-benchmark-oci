# Stack-generated config for aeron-io/benchmarks wrappers (source before running wrapper-echo-unified.sh).
# Paths from Ansible; echo/cluster targets use stable hostnames (see /etc/hosts, provisioned by the aeron-benchmark role).

# -------- Global (defaults from Ansible; override in shell before sourcing if needed) --------
RUNS="${RUNS:-{{ benchmark_echo_runs }}}"
ITERATIONS="${ITERATIONS:-{{ benchmark_echo_iterations }}}"
WARMUP_ITERATIONS="${WARMUP_ITERATIONS:-{{ benchmark_echo_warmup_iterations }}}"
MESSAGE_LENGTH="${MESSAGE_LENGTH:-{{ message_length }}}"
MESSAGE_RATE="${MESSAGE_RATE:-{{ message_rate }}}"
WARMUP_MESSAGE_RATE="${WARMUP_MESSAGE_RATE:-{{ benchmark_echo_warmup_message_rate }}}"
MTU_VALUE="${MTU_VALUE:-8K}"

# Java 17+ required for benchmarks repo (--add-opens for Agrona)
JVM_OPTS="${JVM_OPTS:---add-opens java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED}"

# -------- Paths (stack uses /opt/aeron) --------
export SSH_KEY_FILE="{{ aeron_dir }}/.ssh/deploy_key"
export CLIENT_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
export SERVER_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
export CLIENT_JAVA_HOME="/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64"
export SERVER_JAVA_HOME="/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64"

# -------- Echo (2-node) client/server — SSH uses same names as Aeron endpoints (/etc/hosts) --------
export SSH_USER="{{ ssh_username | default('ubuntu') }}"
{% if (client_node_ip | default('') | trim) %}
export SSH_CLIENT_NODE="{{ aeron_benchmark_client_hostname }}"
{% else %}
export SSH_CLIENT_NODE=""
{% endif %}
{% if (receiver_node_ip | default('') | trim) %}
export SSH_SERVER_NODE="{{ aeron_benchmark_receiver_hostname }}"
{% else %}
export SSH_SERVER_NODE=""
{% endif %}

# Echo CPU pinning (locked profile — docs/CHECKLIST.md; scales with benchmark_ocpus × HT)
{% set _ht_echo = hyperthreading | default(false) | bool %}
{% set _mult_echo = 2 if _ht_echo else 1 %}
{% set _oc_echo = benchmark_ocpus | default(10) | int %}
{% set _last_echo = [_oc_echo * _mult_echo - 1, 0] | max %}
{% if _last_echo >= 1 %}
export CLIENT_NON_ISOLATED_CPU_CORES="${CLIENT_NON_ISOLATED_CPU_CORES:-1-{{ _last_echo }}}"
export SERVER_NON_ISOLATED_CPU_CORES="${SERVER_NON_ISOLATED_CPU_CORES:-1-{{ _last_echo }}}"
export CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE="${CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE:-{{ [_last_echo - 1, 2] | max }}}"
export SERVER_ECHO_CPU_CORE="${SERVER_ECHO_CPU_CORE:-{{ _last_echo }}}"
{% endif %}
# Default to C media driver for latency echo (override with CLIENT_MODE/SERVER_MODE=java if needed)
export CLIENT_MODE="${CLIENT_MODE:-c}"
export SERVER_MODE="${SERVER_MODE:-c}"

# -------- Cluster benchmark topology --------
# client   -> benchmark-1
# node0    -> benchmark-2
# backup   -> failover node (only when enabled/provisioned)
{% if (client_node_ip | default('') | trim) %}
export CLUSTER_SSH_CLIENT_NODE="{{ aeron_benchmark_client_hostname }}"
{% else %}
export CLUSTER_SSH_CLIENT_NODE=""
{% endif %}
{% if (receiver_node_ip | default('') | trim) %}
export CLUSTER_SSH_CLUSTER_NODE0="{{ aeron_benchmark_receiver_hostname }}"
{% else %}
export CLUSTER_SSH_CLUSTER_NODE0=""
{% endif %}
{% if (failover_node_ip | default('') | trim) %}
export CLUSTER_SSH_BACKUP_NODE0="{{ aeron_benchmark_failover_hostname }}"
{% else %}
export CLUSTER_SSH_BACKUP_NODE0=""
{% endif %}
{% set _cluster_backup_n = '1' if (failover_node_ip | default('') | trim) else '0' %}
export CLUSTER_BACKUP_NODES="{{ _cluster_backup_n }}"
# Ensure cluster wrapper uses /opt/aeron deployment paths
export CLUSTER_CLIENT_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
export CLUSTER_NODE0_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
{# auto: wrapper-cluster-unified.sh SSH-probes numactl node 0 on the receiver. static: pin from OCPU×(HT?2:1). #}
{% set _affinity = (benchmark_cluster_cpu_affinity | default('auto') | lower) %}
{% set _ht = hyperthreading | default(false) | bool %}
{% set _mult = 2 if _ht else 1 %}
{% set _oc = benchmark_ocpus | default(10) | int %}
{% set _last_static = [_oc * _mult - 1, 0] | max %}
export CLUSTER_CPU_AFFINITY_MODE="${CLUSTER_CPU_AFFINITY_MODE:-{{ _affinity }}}"
export CLUSTER_CPU_AFFINITY_FALLBACK_LAST="${CLUSTER_CPU_AFFINITY_FALLBACK_LAST:-{{ _last_static }}}"
{% if _affinity == 'static' %}
export CLUSTER_AERON_SSH_TASKSET_CPUS="${CLUSTER_AERON_SSH_TASKSET_CPUS:-0-{{ _last_static }}}"
export CLUSTER_CLIENT_NON_ISOLATED_CPU_CORES="${CLUSTER_CLIENT_NON_ISOLATED_CPU_CORES:-0-{{ _last_static }}}"
export CLUSTER_NODE0_NON_ISOLATED_CPU_CORES="${CLUSTER_NODE0_NON_ISOLATED_CPU_CORES:-0-{{ _last_static }}}"
export CLUSTER_CLIENT_DRIVER_CONDUCTOR_CPU_CORE="${CLUSTER_CLIENT_DRIVER_CONDUCTOR_CPU_CORE:-{{ [4, _last_static] | min }}}"
export CLUSTER_CLIENT_DRIVER_SENDER_CPU_CORE="${CLUSTER_CLIENT_DRIVER_SENDER_CPU_CORE:-{{ [5, _last_static] | min }}}"
export CLUSTER_CLIENT_DRIVER_RECEIVER_CPU_CORE="${CLUSTER_CLIENT_DRIVER_RECEIVER_CPU_CORE:-{{ [6, _last_static] | min }}}"
export CLUSTER_CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE="${CLUSTER_CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE:-{{ [7, _last_static] | min }}}"
export CLUSTER_NODE0_DRIVER_CONDUCTOR_CPU_CORE="${CLUSTER_NODE0_DRIVER_CONDUCTOR_CPU_CORE:-{{ [4, _last_static] | min }}}"
export CLUSTER_NODE0_DRIVER_SENDER_CPU_CORE="${CLUSTER_NODE0_DRIVER_SENDER_CPU_CORE:-{{ [5, _last_static] | min }}}"
export CLUSTER_NODE0_DRIVER_RECEIVER_CPU_CORE="${CLUSTER_NODE0_DRIVER_RECEIVER_CPU_CORE:-{{ [6, _last_static] | min }}}"
export CLUSTER_NODE0_CONSENSUS_MODULE_CPU_CORE="${CLUSTER_NODE0_CONSENSUS_MODULE_CPU_CORE:-{{ [7, _last_static] | min }}}"
export CLUSTER_NODE0_CLUSTERED_SERVICE_CPU_CORE="${CLUSTER_NODE0_CLUSTERED_SERVICE_CPU_CORE:-{{ [8, _last_static] | min }}}"
export CLUSTER_NODE0_ARCHIVE_RECORDER_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_RECORDER_CPU_CORE:-{{ [9, _last_static] | min }}}"
export CLUSTER_NODE0_ARCHIVE_REPLAYER_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_REPLAYER_CPU_CORE:-{{ [10, _last_static] | min }}}"
export CLUSTER_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE:-{{ [11, _last_static] | min }}}"
{% endif %}

# OpenOnload prefix for remote java/c launches (passed to aeron-io/benchmarks --onload).
# OCI and most cloud VMs do not ship `onload`; use env as a no-op so numactl runs java directly.
# For Solarflare + java_vma / c_vma: export ONLOAD_COMMAND='onload --profile=latency'
export ONLOAD_COMMAND="${ONLOAD_COMMAND:-env}"

# Echo UDP channels — Appendix A shape, or Aeron 1.50+ |interface={ifname} (NamedInterface in aeron driver).
# Override with full CLIENT_* / SERVER_* CHANNEL vars, or AERON_ECHO_UDP_NAMED_INTERFACE / AERON_ECHO_UDP_INTERFACE_PREFIX_LENGTH.
{% set _named_in = (aeron_echo_udp_named_interface | default('') | trim) %}
{% if _named_in %}
{% if _named_in.startswith('{') %}
{% set _iface = _named_in %}
{% else %}
{% set _iface = '{' + _named_in + '}' %}
{% endif %}
export AERON_ECHO_UDP_NAMED_INTERFACE='{{ _iface }}'
export AERON_ECHO_UDP_INTERFACE_PREFIX_LENGTH=""
# Named |interface={ifname}: single-quoted URIs so {ifname} is literal; no ${VAR:-...} (bash } vs brace clash).
export CLIENT_SOURCE_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_client_hostname }}:13100|interface={{ _iface }}'
export CLIENT_DESTINATION_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_receiver_hostname }}:13000|interface={{ _iface }}'
export SERVER_SOURCE_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_client_hostname }}:13100|interface={{ _iface }}'
export SERVER_DESTINATION_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_receiver_hostname }}:13000|interface={{ _iface }}'
{% set _cnode0 = 20000 %}
{% set _clog = _cnode0 + 2 %}
{% set _carch = _cnode0 + 4 %}
{% set _bbase = 23000 %}
{% set _bcatch = _bbase + 3 %}
{% set _bactl = _bbase + 4 %}
{% set _bars = _bbase + 5 %}
{% set _barepl = _bbase + 6 %}
# Cluster: ingress channel MUST match byte-for-byte on node0 (publisher) and client (subscriber); per-host interface= breaks AWAIT_PUBLICATION_CONNECTED.
# Client egress: do NOT add |interface=client_ip — the same URI is used when the leader creates its outbound publication; client-only interface breaks POLL_RESPONSE (egress.isConnected=false).
export CLUSTER_NODE0_CLUSTER_INGRESS_CHANNEL='aeron:udp'
export CLUSTER_NODE0_CLUSTER_CONSENSUS_CHANNEL='aeron:udp?term-length=64k|interface={{ _iface }}'
export CLUSTER_NODE0_CLUSTER_LOG_CHANNEL='aeron:udp?term-length=64m|controlmode=manual|control={{ aeron_benchmark_receiver_hostname }}:{{ _clog }}|interface={{ _iface }}'
export CLUSTER_NODE0_CLUSTER_REPLICATION_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_receiver_hostname }}:20022|interface={{ _iface }}'
export CLUSTER_NODE0_ARCHIVE_CONTROL_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_receiver_hostname }}:{{ _carch }}|interface={{ _iface }}'
export CLUSTER_NODE0_ARCHIVE_REPLICATION_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_receiver_hostname }}:20044|interface={{ _iface }}'
export CLUSTER_CLIENT_INGRESS_CHANNEL='aeron:udp'
{# endpoint= client IP; no |interface= (see comment above). #}
{% if (client_node_ip | default('') | trim) %}
export CLUSTER_CLIENT_EGRESS_CHANNEL='aeron:udp?endpoint={{ client_node_ip }}:0'
{% else %}
export CLUSTER_CLIENT_EGRESS_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_client_hostname }}:0'
{% endif %}
{% if (failover_node_ip | default('') | trim) %}
export CLUSTER_BACKUP_NODE0_CLUSTER_CONSENSUS_CHANNEL='aeron:udp?term-length=64k|control-mode=manual|interface={{ _iface }}'
export CLUSTER_BACKUP_NODE0_CLUSTER_BACKUP_CATCHUP_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _bcatch }}|interface={{ _iface }}'
export CLUSTER_BACKUP_NODE0_ARCHIVE_CONTROL_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _bactl }}|interface={{ _iface }}'
export CLUSTER_BACKUP_NODE0_ARCHIVE_CONTROL_RESPONSE_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _bars }}|interface={{ _iface }}'
export CLUSTER_BACKUP_NODE0_ARCHIVE_REPLICATION_CHANNEL='aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _barepl }}|interface={{ _iface }}'
{% endif %}
{% else %}
{% set _ifpfx = (aeron_echo_udp_interface_prefix_length | default('24') | trim) %}
{% if _ifpfx %}
{# endpoint= stable hostnames (/etc/hosts); interface= IP/prefix — Aeron parses prefix as int after '/' (hostnames here caused AsciiNumberFormatException e.g. '24}'). #}
{% set _cidr_cs = 'aeron:udp?endpoint=' ~ aeron_benchmark_client_hostname ~ ':13100|interface=' ~ client_node_ip ~ '/' ~ _ifpfx %}
{% set _cidr_cd = 'aeron:udp?endpoint=' ~ aeron_benchmark_receiver_hostname ~ ':13000|interface=' ~ client_node_ip ~ '/' ~ _ifpfx %}
{% set _cidr_ss = 'aeron:udp?endpoint=' ~ aeron_benchmark_client_hostname ~ ':13100|interface=' ~ receiver_node_ip ~ '/' ~ _ifpfx %}
{% set _cidr_sd = 'aeron:udp?endpoint=' ~ aeron_benchmark_receiver_hostname ~ ':13000|interface=' ~ receiver_node_ip ~ '/' ~ _ifpfx %}
export AERON_ECHO_UDP_NAMED_INTERFACE=""
# Plain exports avoid bash `${VAR:-...}}` / Jinja `}}` eating a `}` (Aeron saw prefix as `24}`).
export AERON_ECHO_UDP_INTERFACE_PREFIX_LENGTH="{{ _ifpfx }}"
export CLIENT_SOURCE_CHANNEL="{{ _cidr_cs }}"
export CLIENT_DESTINATION_CHANNEL="{{ _cidr_cd }}"
export SERVER_SOURCE_CHANNEL="{{ _cidr_ss }}"
export SERVER_DESTINATION_CHANNEL="{{ _cidr_sd }}"
{% set _cnode0 = 20000 %}
{% set _clog = _cnode0 + 2 %}
{% set _carch = _cnode0 + 4 %}
{% set _bbase = 23000 %}
{% set _bcatch = _bbase + 3 %}
{% set _bactl = _bbase + 4 %}
{% set _bars = _bbase + 5 %}
{% set _barepl = _bbase + 6 %}
export CLUSTER_NODE0_CLUSTER_INGRESS_CHANNEL="aeron:udp"
export CLUSTER_NODE0_CLUSTER_CONSENSUS_CHANNEL="aeron:udp?term-length=64k|interface={{ receiver_node_ip }}/{{ _ifpfx }}"
export CLUSTER_NODE0_CLUSTER_LOG_CHANNEL="aeron:udp?term-length=64m|controlmode=manual|control={{ aeron_benchmark_receiver_hostname }}:{{ _clog }}|interface={{ receiver_node_ip }}/{{ _ifpfx }}"
export CLUSTER_NODE0_CLUSTER_REPLICATION_CHANNEL="aeron:udp?endpoint={{ receiver_node_ip }}:20022|interface={{ receiver_node_ip }}/{{ _ifpfx }}"
export CLUSTER_NODE0_ARCHIVE_CONTROL_CHANNEL="aeron:udp?endpoint={{ receiver_node_ip }}:{{ _carch }}|interface={{ receiver_node_ip }}/{{ _ifpfx }}"
export CLUSTER_NODE0_ARCHIVE_REPLICATION_CHANNEL="aeron:udp?endpoint={{ receiver_node_ip }}:20044|interface={{ receiver_node_ip }}/{{ _ifpfx }}"
export CLUSTER_CLIENT_INGRESS_CHANNEL="aeron:udp"
export CLUSTER_CLIENT_EGRESS_CHANNEL="aeron:udp?endpoint={{ client_node_ip }}:0"
{% if (failover_node_ip | default('') | trim) %}
export CLUSTER_BACKUP_NODE0_CLUSTER_CONSENSUS_CHANNEL="aeron:udp?term-length=64k|control-mode=manual|interface={{ failover_node_ip }}/{{ _ifpfx }}"
export CLUSTER_BACKUP_NODE0_CLUSTER_BACKUP_CATCHUP_CHANNEL="aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _bcatch }}|interface={{ failover_node_ip }}/{{ _ifpfx }}"
export CLUSTER_BACKUP_NODE0_ARCHIVE_CONTROL_CHANNEL="aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _bactl }}|interface={{ failover_node_ip }}/{{ _ifpfx }}"
export CLUSTER_BACKUP_NODE0_ARCHIVE_CONTROL_RESPONSE_CHANNEL="aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _bars }}|interface={{ failover_node_ip }}/{{ _ifpfx }}"
export CLUSTER_BACKUP_NODE0_ARCHIVE_REPLICATION_CHANNEL="aeron:udp?endpoint={{ aeron_benchmark_failover_hostname }}:{{ _barepl }}|interface={{ failover_node_ip }}/{{ _ifpfx }}"
{% endif %}
{% else %}
{% set _omit_cs = 'aeron:udp?endpoint=' ~ aeron_benchmark_client_hostname ~ ':13100' %}
{% set _omit_cd = 'aeron:udp?endpoint=' ~ aeron_benchmark_receiver_hostname ~ ':13000' %}
export AERON_ECHO_UDP_NAMED_INTERFACE=""
export AERON_ECHO_UDP_INTERFACE_PREFIX_LENGTH=""
export CLIENT_SOURCE_CHANNEL="{{ _omit_cs }}"
export CLIENT_DESTINATION_CHANNEL="{{ _omit_cd }}"
export SERVER_SOURCE_CHANNEL="{{ _omit_cs }}"
export SERVER_DESTINATION_CHANNEL="{{ _omit_cd }}"
{% endif %}
{% endif %}

# Aeron latency tuning
export AERON_SOCKET_SO_SNDBUF="${AERON_SOCKET_SO_SNDBUF:-2m}"
export AERON_SOCKET_SO_RCVBUF="${AERON_SOCKET_SO_RCVBUF:-2m}"
export AERON_NETWORK_PUBLICATION_MAX_MESSAGES_PER_SEND="${AERON_NETWORK_PUBLICATION_MAX_MESSAGES_PER_SEND:-1}"
export AERON_RECEIVER_IO_VECTOR_CAPACITY="${AERON_RECEIVER_IO_VECTOR_CAPACITY:-1}"
export AERON_SENDER_IO_VECTOR_CAPACITY="${AERON_SENDER_IO_VECTOR_CAPACITY:-1}"
