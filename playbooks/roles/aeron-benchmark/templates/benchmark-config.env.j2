# Stack-generated config for aeron-io/benchmarks wrappers (source before running wrapper-echo-unified.sh).
# Paths from Ansible; echo/cluster targets use stable hostnames (see /etc/hosts, provisioned by the aeron-benchmark role).

# -------- Global (defaults from Ansible; override in shell before sourcing if needed) --------
RUNS="${RUNS:-{{ benchmark_echo_runs }}}"
ITERATIONS="${ITERATIONS:-{{ benchmark_echo_iterations }}}"
WARMUP_ITERATIONS="${WARMUP_ITERATIONS:-{{ benchmark_echo_warmup_iterations }}}"
MESSAGE_LENGTH="${MESSAGE_LENGTH:-{{ message_length }}}"
MESSAGE_RATE="${MESSAGE_RATE:-{{ message_rate }}}"
WARMUP_MESSAGE_RATE="${WARMUP_MESSAGE_RATE:-{{ benchmark_echo_warmup_message_rate }}}"
MTU_VALUE="${MTU_VALUE:-8K}"

# Java 17+ required for benchmarks repo (--add-opens for Agrona)
JVM_OPTS="${JVM_OPTS:---add-opens java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED}"

# -------- Paths (stack uses /opt/aeron) --------
{% set _java_home = '/usr/lib/jvm/java-' ~ java_version ~ '-openjdk' if ansible_os_family == 'RedHat' else '/usr/lib/jvm/java-' ~ java_version ~ '-openjdk-amd64' %}
export SSH_KEY_FILE="{{ aeron_dir }}/.ssh/deploy_key"
export CLIENT_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
export SERVER_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
export CLIENT_JAVA_HOME="{{ _java_home }}"
export SERVER_JAVA_HOME="{{ _java_home }}"

# -------- Echo (2-node) client/server — SSH uses same names as Aeron endpoints (/etc/hosts) --------
export SSH_USER="{{ ssh_username | default('ubuntu') }}"
{% if (client_node_ip | default('') | trim) %}
export SSH_CLIENT_NODE="{{ aeron_benchmark_client_hostname }}"
{% else %}
export SSH_CLIENT_NODE=""
{% endif %}
{% if (receiver_node_ip | default('') | trim) %}
export SSH_SERVER_NODE="{{ aeron_benchmark_receiver_hostname }}"
{% else %}
export SSH_SERVER_NODE=""
{% endif %}

{# Optional OCI RDMA fabric address derivation.
   The BM.Optimized3 cluster-network bring-up assigns the RDMA netdev an address by
   reusing the host octet from the primary private IP, for example:
   10.34.1.234 -> 10.34.100.234/24 on eth1. #}
{% set _rdma_ip_prefix = (benchmark_cloud_init_rdma_ipv4_prefix | default('') | trim) %}
{% set _rdma_prefix_length = (benchmark_cloud_init_rdma_prefix_length | default(24) | string | trim) %}
{% set _client_private_ip = (client_node_ip | default('') | trim) %}
{% set _receiver_private_ip = (receiver_node_ip | default('') | trim) %}
{% set _failover_private_ip = (failover_node_ip | default('') | trim) %}
{% set _benchmark_node_ips = (benchmark_node_ips | default('') | string).split(',') %}
{% set _raft_enabled = enable_cluster_raft_consensus | default(false) | bool %}
{% set _node1_private_ip = (_benchmark_node_ips[2] | trim) if (_benchmark_node_ips | length > 2) else '' %}
{% set _node2_private_ip = (_benchmark_node_ips[3] | trim) if (_benchmark_node_ips | length > 3) else '' %}
{% set _rdma_enabled = (_rdma_ip_prefix | length > 0) and (_client_private_ip | length > 0) and (_receiver_private_ip | length > 0) %}
{% if _rdma_enabled %}
{% set _client_aeron_ip = _rdma_ip_prefix ~ '.' ~ (_client_private_ip.split('.') | last) %}
{% set _receiver_aeron_ip = _rdma_ip_prefix ~ '.' ~ (_receiver_private_ip.split('.') | last) %}
{% set _failover_aeron_ip = _rdma_ip_prefix ~ '.' ~ (_failover_private_ip.split('.') | last) if (_failover_private_ip | length > 0) else '' %}
{% set _node1_aeron_ip = _rdma_ip_prefix ~ '.' ~ (_node1_private_ip.split('.') | last) if (_node1_private_ip | length > 0) else '' %}
{% set _node2_aeron_ip = _rdma_ip_prefix ~ '.' ~ (_node2_private_ip.split('.') | last) if (_node2_private_ip | length > 0) else '' %}
{% else %}
{% set _client_aeron_ip = _client_private_ip %}
{% set _receiver_aeron_ip = _receiver_private_ip %}
{% set _failover_aeron_ip = _failover_private_ip %}
{% set _node1_aeron_ip = _node1_private_ip %}
{% set _node2_aeron_ip = _node2_private_ip %}
{% endif %}
{% set _client_endpoint_host = _client_aeron_ip if _rdma_enabled else aeron_benchmark_client_hostname %}
{% set _receiver_endpoint_host = _receiver_aeron_ip if _rdma_enabled else aeron_benchmark_receiver_hostname %}
{% set _failover_endpoint_host = _failover_aeron_ip if _rdma_enabled and (_failover_aeron_ip | length > 0) else aeron_benchmark_failover_hostname %}
{% set _node1_endpoint_host = _node1_aeron_ip if _rdma_enabled and (_node1_aeron_ip | length > 0) else 'aeron-benchmark-node1' %}
{% set _node2_endpoint_host = _node2_aeron_ip if _rdma_enabled and (_node2_aeron_ip | length > 0) else 'aeron-benchmark-node2' %}
{% set _cluster_udp_fabric = benchmark_cluster_udp_fabric | default('auto') | trim | lower %}
{% set _cluster_use_rdma = _rdma_enabled and (_cluster_udp_fabric != 'vcn') %}
{% set _cluster_client_ip = _client_aeron_ip if _cluster_use_rdma else _client_private_ip %}
{% set _cluster_node0_ip = _receiver_aeron_ip if _cluster_use_rdma else _receiver_private_ip %}
{% set _cluster_failover_ip = _failover_aeron_ip if _cluster_use_rdma else _failover_private_ip %}
{% set _cluster_node1_ip = _node1_aeron_ip if _cluster_use_rdma else _node1_private_ip %}
{% set _cluster_node2_ip = _node2_aeron_ip if _cluster_use_rdma else _node2_private_ip %}
{% set _cluster_client_endpoint_host = _cluster_client_ip if (_cluster_client_ip | length > 0) else aeron_benchmark_client_hostname %}
{% set _cluster_node0_endpoint_host = _cluster_node0_ip if (_cluster_node0_ip | length > 0) else aeron_benchmark_receiver_hostname %}
{% set _cluster_failover_endpoint_host = _cluster_failover_ip if (_cluster_failover_ip | length > 0) else aeron_benchmark_failover_hostname %}
{% set _cluster_node1_endpoint_host = _cluster_node1_ip if (_cluster_node1_ip | length > 0) else 'aeron-benchmark-node1' %}
{% set _cluster_node2_endpoint_host = _cluster_node2_ip if (_cluster_node2_ip | length > 0) else 'aeron-benchmark-node2' %}
{% set _rdma_profile_enabled = benchmark_cloud_init_rdma | default(false) | bool %}
{% set _profile_requested = benchmark_tuning_profile | default('auto') | trim | lower %}
{% set _benchmark_tuning_profile = ('bm_rdma' if _rdma_profile_enabled else 'vm_stable') if _profile_requested == 'auto' else _profile_requested %}
export AERON_RDMA_FABRIC_ENABLED="{{ '1' if _rdma_enabled else '0' }}"
export AERON_RDMA_INTERFACE="{{ benchmark_cloud_init_rdma_interface | default('eth1') }}"
export AERON_RDMA_IPV4_PREFIX="{{ _rdma_ip_prefix }}"
export AERON_CLUSTER_UDP_FABRIC="{{ 'rdma' if _cluster_use_rdma else 'vcn' }}"
export BENCHMARK_TUNING_PROFILE="{{ _benchmark_tuning_profile }}"
export BENCHMARK_CPU_PROFILE="{{ benchmark_cpu_profile | default('auto') }}"
export BENCHMARK_HOUSEKEEPING_CPUS="{{ benchmark_housekeeping_cpus_override | default('') }}"
export BENCHMARK_ISOLATED_CPUS="{{ benchmark_isolated_cpus_override | default('') }}"
export BENCHMARK_ECHO_CLIENT_PINS="{{ benchmark_echo_client_pins | default('') }}"
export BENCHMARK_ECHO_SERVER_PINS="{{ benchmark_echo_server_pins | default('') }}"

{# Housekeeping band from aeron-install GRUB facts when this template is rendered on a benchmark node.
   The controller also renders this file for the post-apply matrix, but it does not have benchmark-node CPU facts.
   Echo affinity is therefore intentionally left to wrapper-echo-unified.sh, which probes the live client/receiver
   over SSH and scales correctly for 10, 32, 36 BM, 64, etc. #}
{% set _hk_raw = housekeeping_cpus | default('0-1') | trim %}
{% set _hk_last = (_hk_raw.split('-') | last | int) %}

# Echo CPU pinning is resolved live by wrapper-echo-unified.sh.
# Do not export CLIENT_/SERVER_* CPU affinity defaults here: the controller-rendered config only sees
# group_vars housekeeping defaults, so exporting them here silently pins larger nodes to 0-1.
{% set _ht_echo = hyperthreading | default(false) | bool %}
{% set _mult_echo = 2 if _ht_echo else 1 %}
{% set _oc_echo = benchmark_ocpus | default(10) | int %}
{# Keep these calculated for comments/backward compatibility; wrapper validates via live getconf/lscpu. #}
{% set _tf_last_echo = [_oc_echo * _mult_echo - 1, 0] | max %}
{% set _last_echo = [_tf_last_echo, _hk_last] | min %}
# Default to C media driver for latency echo (override with CLIENT_MODE/SERVER_MODE=java if needed)
export CLIENT_MODE="${CLIENT_MODE:-c}"
export SERVER_MODE="${SERVER_MODE:-c}"

# -------- Cluster benchmark topology --------
# client   -> first benchmark node (Terraform display *-client)
# node0    -> second benchmark node (*-receiver)
# backup   -> failover node (only when enabled/provisioned)
{% if (client_node_ip | default('') | trim) %}
export CLUSTER_SSH_CLIENT_NODE="{{ aeron_benchmark_client_hostname }}"
{% else %}
export CLUSTER_SSH_CLIENT_NODE=""
{% endif %}
{% if (receiver_node_ip | default('') | trim) %}
export CLUSTER_SSH_CLUSTER_NODE0="{{ aeron_benchmark_receiver_hostname }}"
{% else %}
export CLUSTER_SSH_CLUSTER_NODE0=""
{% endif %}
{% if _raft_enabled and (_node1_private_ip | length > 0) %}
export CLUSTER_SSH_CLUSTER_NODE1="aeron-benchmark-node1"
{% endif %}
{% if _raft_enabled and (_node2_private_ip | length > 0) %}
export CLUSTER_SSH_CLUSTER_NODE2="aeron-benchmark-node2"
{% endif %}
{% if (failover_node_ip | default('') | trim) %}
export CLUSTER_SSH_BACKUP_NODE0="${CLUSTER_SSH_BACKUP_NODE0:-{{ aeron_benchmark_failover_hostname }}}"
{% else %}
export CLUSTER_SSH_BACKUP_NODE0="${CLUSTER_SSH_BACKUP_NODE0:-}"
{% endif %}
{% set _cluster_backup_n = '1' if (failover_node_ip | default('') | trim) else '0' %}
export CLUSTER_RAFT_CONSENSUS="${CLUSTER_RAFT_CONSENSUS:-{{ '1' if _raft_enabled else '0' }}}"
export CLUSTER_SIZE="${CLUSTER_SIZE:-{{ '3' if _raft_enabled else '1' }}}"
export CLUSTER_BACKUP_NODES="${CLUSTER_BACKUP_NODES:-{{ '0' if _raft_enabled else _cluster_backup_n }}}"
export CLUSTER_NODE0_ENDPOINT_HOST="${CLUSTER_NODE0_ENDPOINT_HOST:-{{ _cluster_node0_endpoint_host }}}"
{% if _raft_enabled %}
export CLUSTER_NODE1_ENDPOINT_HOST="${CLUSTER_NODE1_ENDPOINT_HOST:-{{ _cluster_node1_endpoint_host }}}"
export CLUSTER_NODE2_ENDPOINT_HOST="${CLUSTER_NODE2_ENDPOINT_HOST:-{{ _cluster_node2_endpoint_host }}}"
{% endif %}
# Ensure cluster wrapper uses /opt/aeron deployment paths
export CLUSTER_CLIENT_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
export CLUSTER_NODE0_BENCHMARKS_PATH="{{ benchmarks_dist_path }}"
export CLUSTER_CLIENT_JAVA_HOME="{{ _java_home }}"
export CLUSTER_NODE0_JAVA_HOME="{{ _java_home }}"
{# auto: wrapper-cluster-unified.sh SSH-probes numactl node 0 on the receiver. static: pin from OCPU×(HT?2:1). #}
{% set _affinity = (benchmark_cluster_cpu_affinity | default('auto') | lower) %}
{% set _ht = hyperthreading | default(false) | bool %}
{% set _mult = 2 if _ht else 1 %}
{% set _oc = benchmark_ocpus | default(10) | int %}
{% set _last_static = [_oc * _mult - 1, 0] | max %}
{% set _bm_cluster_static = _benchmark_tuning_profile == 'bm_rdma' %}
export CLUSTER_CPU_AFFINITY_MODE="${CLUSTER_CPU_AFFINITY_MODE:-{{ 'static' if _bm_cluster_static else _affinity }}}"
export CLUSTER_CPU_AFFINITY_FALLBACK_LAST="${CLUSTER_CPU_AFFINITY_FALLBACK_LAST:-{{ _last_static }}}"
{% if _bm_cluster_static %}
{# BM Optimized3 static pins below are 20-31, which are NUMA node1 after SMT is disabled. #}
export CLUSTER_CLIENT_CPU_NODE="${CLUSTER_CLIENT_CPU_NODE:-1}"
export CLUSTER_NODE0_CPU_NODE="${CLUSTER_NODE0_CPU_NODE:-1}"
export CLUSTER_NODE1_CPU_NODE="${CLUSTER_NODE1_CPU_NODE:-1}"
export CLUSTER_NODE2_CPU_NODE="${CLUSTER_NODE2_CPU_NODE:-1}"
export CLUSTER_BACKUP_NODE0_CPU_NODE="${CLUSTER_BACKUP_NODE0_CPU_NODE:-1}"
export CLUSTER_AERON_SSH_TASKSET_CPUS="${CLUSTER_AERON_SSH_TASKSET_CPUS:-20-31}"
export CLUSTER_CLIENT_NON_ISOLATED_CPU_CORES="${CLUSTER_CLIENT_NON_ISOLATED_CPU_CORES:-20-31}"
export CLUSTER_NODE0_NON_ISOLATED_CPU_CORES="${CLUSTER_NODE0_NON_ISOLATED_CPU_CORES:-20-31}"
export CLUSTER_BACKUP_NODE0_NON_ISOLATED_CPU_CORES="${CLUSTER_BACKUP_NODE0_NON_ISOLATED_CPU_CORES:-20-31}"
export CLUSTER_CLIENT_DRIVER_CONDUCTOR_CPU_CORE="${CLUSTER_CLIENT_DRIVER_CONDUCTOR_CPU_CORE:-24}"
export CLUSTER_CLIENT_DRIVER_SENDER_CPU_CORE="${CLUSTER_CLIENT_DRIVER_SENDER_CPU_CORE:-25}"
export CLUSTER_CLIENT_DRIVER_RECEIVER_CPU_CORE="${CLUSTER_CLIENT_DRIVER_RECEIVER_CPU_CORE:-26}"
export CLUSTER_CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE="${CLUSTER_CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE:-27}"
export CLUSTER_NODE0_DRIVER_CONDUCTOR_CPU_CORE="${CLUSTER_NODE0_DRIVER_CONDUCTOR_CPU_CORE:-24}"
export CLUSTER_NODE0_DRIVER_SENDER_CPU_CORE="${CLUSTER_NODE0_DRIVER_SENDER_CPU_CORE:-25}"
export CLUSTER_NODE0_DRIVER_RECEIVER_CPU_CORE="${CLUSTER_NODE0_DRIVER_RECEIVER_CPU_CORE:-26}"
export CLUSTER_NODE0_CONSENSUS_MODULE_CPU_CORE="${CLUSTER_NODE0_CONSENSUS_MODULE_CPU_CORE:-27}"
export CLUSTER_NODE0_CLUSTERED_SERVICE_CPU_CORE="${CLUSTER_NODE0_CLUSTERED_SERVICE_CPU_CORE:-28}"
export CLUSTER_NODE0_ARCHIVE_RECORDER_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_RECORDER_CPU_CORE:-29}"
export CLUSTER_NODE0_ARCHIVE_REPLAYER_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_REPLAYER_CPU_CORE:-30}"
export CLUSTER_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE:-31}"
export CLUSTER_BACKUP_NODE0_DRIVER_CONDUCTOR_CPU_CORE="${CLUSTER_BACKUP_NODE0_DRIVER_CONDUCTOR_CPU_CORE:-24}"
export CLUSTER_BACKUP_NODE0_DRIVER_SENDER_CPU_CORE="${CLUSTER_BACKUP_NODE0_DRIVER_SENDER_CPU_CORE:-25}"
export CLUSTER_BACKUP_NODE0_DRIVER_RECEIVER_CPU_CORE="${CLUSTER_BACKUP_NODE0_DRIVER_RECEIVER_CPU_CORE:-26}"
export CLUSTER_BACKUP_NODE0_CLUSTER_BACKUP_CPU_CORE="${CLUSTER_BACKUP_NODE0_CLUSTER_BACKUP_CPU_CORE:-28}"
export CLUSTER_BACKUP_NODE0_ARCHIVE_RECORDER_CPU_CORE="${CLUSTER_BACKUP_NODE0_ARCHIVE_RECORDER_CPU_CORE:-29}"
export CLUSTER_BACKUP_NODE0_ARCHIVE_REPLAYER_CPU_CORE="${CLUSTER_BACKUP_NODE0_ARCHIVE_REPLAYER_CPU_CORE:-30}"
export CLUSTER_BACKUP_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE="${CLUSTER_BACKUP_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE:-31}"
{% elif _affinity == 'static' %}
export CLUSTER_AERON_SSH_TASKSET_CPUS="${CLUSTER_AERON_SSH_TASKSET_CPUS:-0-{{ _last_static }}}"
export CLUSTER_CLIENT_NON_ISOLATED_CPU_CORES="${CLUSTER_CLIENT_NON_ISOLATED_CPU_CORES:-0-{{ _last_static }}}"
export CLUSTER_NODE0_NON_ISOLATED_CPU_CORES="${CLUSTER_NODE0_NON_ISOLATED_CPU_CORES:-0-{{ _last_static }}}"
export CLUSTER_CLIENT_DRIVER_CONDUCTOR_CPU_CORE="${CLUSTER_CLIENT_DRIVER_CONDUCTOR_CPU_CORE:-{{ [4, _last_static] | min }}}"
export CLUSTER_CLIENT_DRIVER_SENDER_CPU_CORE="${CLUSTER_CLIENT_DRIVER_SENDER_CPU_CORE:-{{ [5, _last_static] | min }}}"
export CLUSTER_CLIENT_DRIVER_RECEIVER_CPU_CORE="${CLUSTER_CLIENT_DRIVER_RECEIVER_CPU_CORE:-{{ [6, _last_static] | min }}}"
export CLUSTER_CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE="${CLUSTER_CLIENT_LOAD_TEST_RIG_MAIN_CPU_CORE:-{{ [7, _last_static] | min }}}"
export CLUSTER_NODE0_DRIVER_CONDUCTOR_CPU_CORE="${CLUSTER_NODE0_DRIVER_CONDUCTOR_CPU_CORE:-{{ [4, _last_static] | min }}}"
export CLUSTER_NODE0_DRIVER_SENDER_CPU_CORE="${CLUSTER_NODE0_DRIVER_SENDER_CPU_CORE:-{{ [5, _last_static] | min }}}"
export CLUSTER_NODE0_DRIVER_RECEIVER_CPU_CORE="${CLUSTER_NODE0_DRIVER_RECEIVER_CPU_CORE:-{{ [6, _last_static] | min }}}"
export CLUSTER_NODE0_CONSENSUS_MODULE_CPU_CORE="${CLUSTER_NODE0_CONSENSUS_MODULE_CPU_CORE:-{{ [7, _last_static] | min }}}"
export CLUSTER_NODE0_CLUSTERED_SERVICE_CPU_CORE="${CLUSTER_NODE0_CLUSTERED_SERVICE_CPU_CORE:-{{ [8, _last_static] | min }}}"
export CLUSTER_NODE0_ARCHIVE_RECORDER_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_RECORDER_CPU_CORE:-{{ [9, _last_static] | min }}}"
export CLUSTER_NODE0_ARCHIVE_REPLAYER_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_REPLAYER_CPU_CORE:-{{ [10, _last_static] | min }}}"
export CLUSTER_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE="${CLUSTER_NODE0_ARCHIVE_CONDUCTOR_CPU_CORE:-{{ [11, _last_static] | min }}}"
{% endif %}

# Prefix passed to aeron-io/benchmarks --onload (java/c/java_vma/c_vma). Plain = no VMA.
# Wrappers and run-driver-matrix pick ONLOAD_COMMAND_PLAIN vs ONLOAD_COMMAND_VMA from driver mode (java vs java_vma).
{% set _vma_lib_path = benchmark_vma_lib_path | default('/usr/lib/x86_64-linux-gnu/libvma.so.9') %}
{% set _vma_cmd_override = benchmark_onload_command_vma | default('') | trim %}
{% if _vma_cmd_override %}
{% set _vma_cmd = _vma_cmd_override %}
{% elif _benchmark_tuning_profile == 'bm_rdma' %}
{% set _vma_cmd = 'sudo -E env AERON_SHM_USER=' ~ (ssh_username | default('ubuntu')) ~ ' AERON_DIR=/dev/shm/aeron VMA_SPEC=latency VMA_RX_POLL=-1 VMA_TRACELEVEL=0 VMA_LOG_DETAILS=0 VMA_LOG_COLORS=0 VMA_OFFLOADED_SOCKETS=1 LD_PRELOAD=' ~ _vma_lib_path %}
{% else %}
{% set _vma_cmd = 'env LD_PRELOAD=' ~ _vma_lib_path %}
{% endif %}
export ONLOAD_COMMAND_PLAIN="${ONLOAD_COMMAND_PLAIN:-env}"
export ONLOAD_COMMAND_VMA="${ONLOAD_COMMAND_VMA:-{{ _vma_cmd }}}"
export VMA_DRIVER_PREFIX="${VMA_DRIVER_PREFIX:-$ONLOAD_COMMAND_VMA}"
export ONLOAD_COMMAND="${ONLOAD_COMMAND:-$ONLOAD_COMMAND_PLAIN}"
{% if _benchmark_tuning_profile == 'bm_rdma' %}
export AERON_DIR="${AERON_DIR:-/dev/shm/aeron}"
export AERON_SHM_USER="${AERON_SHM_USER:-{{ ssh_username | default('ubuntu') }}}"
export AERON_SHM_FIXUP_INTERVAL_SEC="${AERON_SHM_FIXUP_INTERVAL_SEC:-0.5}"
export CLUSTER_SKIP_DROP_CACHES="${CLUSTER_SKIP_DROP_CACHES:-0}"
export CLUSTER_BACKUP_ENABLE_VMA="${CLUSTER_BACKUP_ENABLE_VMA:-1}"
{% endif %}
{% if benchmark_block_volume_enabled | default(false) | bool %}
export CLUSTER_DATA_DIR="${CLUSTER_DATA_DIR:-{{ benchmark_block_volume_mount_path | default('/mnt/aeron-cluster') }}}"
{% endif %}

# Echo UDP channels — Appendix A shape, or Aeron 1.50+ |interface={ifname} (NamedInterface in aeron driver).
# Override with full CLIENT_* / SERVER_* CHANNEL vars, or AERON_ECHO_UDP_NAMED_INTERFACE / AERON_ECHO_UDP_INTERFACE_PREFIX_LENGTH.
{% set _named_in_config = (aeron_echo_udp_named_interface | default('') | trim) %}
{% set _named_in = _named_in_config if (_named_in_config | length > 0) else ((benchmark_cloud_init_rdma_interface | default('eth1') | trim) if _rdma_enabled else '') %}
{% if _named_in %}
{% if _named_in.startswith('{') %}
{% set _iface = _named_in %}
{% else %}
{% set _iface = '{' + _named_in + '}' %}
{% endif %}
export AERON_ECHO_UDP_NAMED_INTERFACE='{{ _iface }}'
export _AERON_IFACE_DEFAULT='{{ _iface }}'
export AERON_ECHO_UDP_INTERFACE_PREFIX_LENGTH=""
# Named |interface={ifname}: single-quoted URIs so {ifname} is literal; no ${VAR:-...} (bash } vs brace clash).
export CLIENT_SOURCE_CHANNEL='aeron:udp?endpoint={{ _client_endpoint_host }}:13100|interface={{ _iface }}'
export CLIENT_DESTINATION_CHANNEL='aeron:udp?endpoint={{ _receiver_endpoint_host }}:13000|interface={{ _iface }}'
export SERVER_SOURCE_CHANNEL='aeron:udp?endpoint={{ _client_endpoint_host }}:13100|interface={{ _iface }}'
export SERVER_DESTINATION_CHANNEL='aeron:udp?endpoint={{ _receiver_endpoint_host }}:13000|interface={{ _iface }}'
{% set _cnode0 = 20000 %}
{% set _clog = _cnode0 + 2 %}
{% set _carch = _cnode0 + 4 %}
{% set _bbase = 23000 %}
{% set _bcatch = _bbase + 3 %}
{% set _bactl = _bbase + 4 %}
{% set _bars = _bbase + 5 %}
{% set _barepl = _bbase + 6 %}
# Cluster: ingress channel MUST match byte-for-byte on node0 (publisher) and client (subscriber); per-host interface= breaks AWAIT_PUBLICATION_CONNECTED.
# Client egress: do NOT add |interface=client_ip — the same URI is used when the leader creates its outbound publication; client-only interface breaks POLL_RESPONSE (egress.isConnected=false).
export CLUSTER_NODE0_CLUSTER_INGRESS_CHANNEL='aeron:udp'
export CLUSTER_NODE0_CLUSTER_CONSENSUS_CHANNEL='aeron:udp?term-length=64k|interface={{ _iface }}'
export CLUSTER_NODE0_CLUSTER_LOG_CHANNEL='aeron:udp?term-length=64m|controlmode=manual|control={{ _receiver_endpoint_host }}:{{ _clog }}|interface={{ _iface }}'
export CLUSTER_NODE0_CLUSTER_REPLICATION_CHANNEL='aeron:udp?endpoint={{ _receiver_endpoint_host }}:20022|interface={{ _iface }}'
export CLUSTER_NODE0_ARCHIVE_CONTROL_CHANNEL='aeron:udp?endpoint={{ _receiver_endpoint_host }}:{{ _carch }}|interface={{ _iface }}'
export CLUSTER_NODE0_ARCHIVE_REPLICATION_CHANNEL='aeron:udp?endpoint={{ _receiver_endpoint_host }}:20044|interface={{ _iface }}'
{% if _raft_enabled %}
export CLUSTER_NODE1_CLUSTER_CONSENSUS_CHANNEL='aeron:udp?term-length=64k|interface={{ _iface }}'
export CLUSTER_NODE1_CLUSTER_INGRESS_CHANNEL='aeron:udp'
export CLUSTER_NODE1_CLUSTER_LOG_CHANNEL='aeron:udp?term-length=64m|controlmode=manual|control={{ _node1_endpoint_host }}:21002|interface={{ _iface }}'
export CLUSTER_NODE1_CLUSTER_REPLICATION_CHANNEL='aeron:udp?endpoint={{ _node1_endpoint_host }}:21022|interface={{ _iface }}'
export CLUSTER_NODE1_ARCHIVE_CONTROL_CHANNEL='aeron:udp?endpoint={{ _node1_endpoint_host }}:21004|interface={{ _iface }}'
export CLUSTER_NODE1_ARCHIVE_REPLICATION_CHANNEL='aeron:udp?endpoint={{ _node1_endpoint_host }}:21044|interface={{ _iface }}'
export CLUSTER_NODE2_CLUSTER_CONSENSUS_CHANNEL='aeron:udp?term-length=64k|interface={{ _iface }}'
export CLUSTER_NODE2_CLUSTER_INGRESS_CHANNEL='aeron:udp'
