export AERON_SOCKET_SO_RCVBUF="${AERON_SOCKET_SO_RCVBUF:-{{ _rcvbuf if _rcvbuf else _profile_rcvbuf }}}"
export AERON_RCV_INITIAL_WINDOW_LENGTH="${AERON_RCV_INITIAL_WINDOW_LENGTH:-{{ _rcvwin if _rcvwin else _profile_rcvwin }}}"
export AERON_NETWORK_PUBLICATION_MAX_MESSAGES_PER_SEND="${AERON_NETWORK_PUBLICATION_MAX_MESSAGES_PER_SEND:-{{ _max_send if _max_send else _profile_max_send }}}"
export AERON_RECEIVER_IO_VECTOR_CAPACITY="${AERON_RECEIVER_IO_VECTOR_CAPACITY:-{{ _recv_iov if _recv_iov else _profile_recv_iov }}}"
